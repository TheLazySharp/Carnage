; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="TURBO SLAYER"
run/main_scene="uid://gmjjc1vmgcds"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://Assets/icon.svg"

[audio]

buses/default_bus_layout="uid://u0shvr2k0bxe"

[autoload]

XPManager="*res://Autoloads/player_xp_manager.gd"
SceneManager="*res://Autoloads/scene_manager.gd"
TimeManager="*res://Autoloads/time_manager.gd"
InventoryManager="*res://Autoloads/inventory_manager.gd"
WeaponsManager="*res://Autoloads/weapons_manager.gd"
CarManager="*res://Autoloads/cars_manager.gd"
StatsManager="*res://Autoloads/stats_manager.gd"
SignalManager="*uid://b24sd62rqu8jc"
AudioMaster="*uid://cfru00x1doqcr"
LuckyCharmsManager="*uid://bcdy4d7pqlrlf"
SurvivorsManager="*uid://crbnfqnw0mqge"
RoadMapManager="*uid://dvfbxb2hpkq5r"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="MyBloodyShooter"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://Autoloads/": "red",
"res://Resources/": "pink",
"res://Scenes/": "blue",
"res://Scripts/": "teal"
}

[global_group]

player=""
ennemies=""
bullets=""
obstacles=""
ressources=""
walls=""
junior=""
collectables=""
weapons=""
explosives=""
survivor=""

